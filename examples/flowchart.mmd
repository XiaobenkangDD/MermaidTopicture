        end
        
        subgraph B4_2[安环评手续流程]
            B4_2a[安全科：办理安评<br>目标：40日历日] --> B4_2b[取得正式批复]
            B4_2c[安全科：办理环评<br>目标：180日历日] --> B4_2d[取得正式批复]
        end
        
        subgraph B4_3[联合踏勘流程]
            B4_3a[通知钻井、录井公司<br>联合踏勘] --> B4_3b[组织联合踏勘]
            B4_3b --> B4_3c[参加联合踏勘]
        end
        
        B4 --> B4_1
        B4 --> B4_2
        B4 --> B4_3
    end
    
    B --> C
    
    subgraph C[钻井工程设计阶段]
        C1[协调钻井队伍及设备] --> C2[1.编制审核钻井地质设计<br>2.工艺院编制钻井工程设计<br>3.钻井公司编制钻井施工设计]
    end
    
    C2 --> D
    
    subgraph D[钻井施工阶段]
