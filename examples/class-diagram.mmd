classDiagram
    class 流程管控系统 {
        +流程ID
        +流程名称
        +创建时间
        +开始流程()
        +暂停流程()
        +结束流程()
    }
    
    class 流程节点 {
        +节点ID
        +节点名称
        +节点类型
        +执行状态
        +执行节点()
        +跳过节点()
    }
    
    class 审批人员 {
        +人员ID
        +姓名
        +职位
        +部门
        +审批()
        +驳回()
    }
    
    class 审批记录 {
        +记录ID
        +审批时间
        +审批意见
        +审批结果
        +保存记录()
    }
    
    class 表单数据 {
        +表单ID
        +表单内容
        +提交时间
        +附件列表
        +提交表单()
        +更新表单()
    }
    
    流程管控系统 "1" --> "*" 流程节点 : 包含
    流程节点 "*" --> "1..*" 审批人员 : 分配给
    审批人员 "1" --> "*" 审批记录 : 产生
    流程节点 "1" --> "0..1" 表单数据 : 关联

