{
  "name": "mermaid-flowchart-generator",
  "version": "1.1.0",
  "description": "使用 Mermaid CLI 生成高清流程图（SVG / PNG / PDF）",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('提示: 已安装本地 Mermaid CLI，可直接 npm run generate / batch-generate')\"",
    "generate": "node scripts/generate-one.js ./examples/flowchart.mmd ./output/flowchart.svg --bg transparent",
    "generate-png": "node scripts/generate-one.js ./examples/flowchart.mmd ./output/flowchart.png --bg white --size 2048 --scale 2",
    "generate-pdf": "node scripts/generate-one.js ./examples/flowchart.mmd ./output/flowchart.pdf --bg white --size 2048 --scale 2",
    "generate-all": "npm run generate && npm run generate-png && npm run generate-pdf",
    "batch-generate": "node scripts/batch-generate.js",
    "batch-generate:all": "node scripts/batch-generate.js -f svg,png,pdf",
    "batch-generate:4k": "node scripts/batch-generate.js -f png --size 3840 -s 3",
    "batch-generate:dark": "node scripts/batch-generate.js -t dark -b transparent",
    "watch": "node scripts/watch-generate.js"
  },
  "keywords": [
    "mermaid",
    "flowchart",
    "diagram",
    "svg",
    "png",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0"
  }
}
