{
  "theme": "default",
  "themeVariables": {
    "primaryColor": "#4A90E2",
    "primaryTextColor": "#ffffff",
    "primaryBorderColor": "#357ABD",
    "lineColor": "#666666",
    "secondaryColor": "#52C41A",
    "tertiaryColor": "#ffffff",
    "fontSize": "16px",
    "fontFamily": "Microsoft YaHei, Noto Sans CJK SC, WenQuanYi Micro Hei, SimHei, Arial, sans-serif"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 30,
    "nodeSpacing": 50,
    "rankSpacing": 50,
    "diagramPadding": 20,
    "htmlLabels": true,
    "useMaxWidth": true
  },
  "sequence": {
    "diagramMarginX": 50,
    "diagramMarginY": 10,
    "actorMargin": 50,
    "width": 150,
    "height": 65,
    "boxMargin": 10,
    "boxTextMargin": 5,
    "noteMargin": 10,
    "messageMargin": 35,
    "useMaxWidth": true
  },
  "gantt": {
    "titleTopMargin": 25,
    "barHeight": 20,
    "barGap": 4,
    "topPadding": 50,
    "leftPadding": 75,
    "gridLineStartPadding": 35,
    "fontSize": 11,
    "numberSectionStyles": 4,
    "useMaxWidth": true
  }
}
